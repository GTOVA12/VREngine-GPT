{
  "version": 5,
  "configurePresets": [
    {
      "name": "windows",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/Build/windows",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "editor",
      "inherits": "windows",
      "binaryDir": "${sourceDir}/Build/editor",
      "cacheVariables": {
        "FACTORYCORE_ENABLE_EDITOR": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "windows",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "windows",
      "configuration": "Release"
    },
    {
      "name": "editor-debug",
      "configurePreset": "editor",
      "configuration": "Debug"
    },
    {
      "name": "editor-release",
      "configurePreset": "editor",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "windows",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "windows",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "editor-debug",
      "configurePreset": "editor",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "editor-release",
      "configurePreset": "editor",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
